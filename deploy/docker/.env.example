# Host NIC (or bridge) that is wired to the LAN your PS5 and Portal are on.
# Find it with: ip -br addr   (eth0, enp3s0, br0, vmbr0, ovs_eth0 on Synology...)
# Wi-Fi interfaces do not work with macvlan.
LAN_PARENT=eth0

# Your LAN, as the router hands it out.
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# A free address for the relay, OUTSIDE your router's DHCP pool (or reserved in it).
RELAY_IP=192.168.1.215
